# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here

# Milvus Connection
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=root:Milvus

# Milvus Collection Names
MILVUS_COLLECTION_MEMORIES=dialectic_memories
MILVUS_COLLECTION_META=dialectic_meta

# Embedding Config
EMBEDDING_USE_LOCAL=true
EMBEDDING_LOCAL_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIM=768

# OpenAI API (if EMBEDDING_USE_LOCAL=false)
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_API_KEY=
OPENAI_API_BASE=

# Search Config
MILVUS_SEARCH_TOP_K=5
MILVUS_SIMILARITY_THRESHOLD=0.7
MILVUS_GPU_ENABLED=false

# Web Search Config
# SEARCH_ENGINE: zhipu (default, recommended for China) | duckduckgo | bing | searxng
SEARCH_ENGINE=zhipu
ZHIPU_AUTH_KEY=your_zhipu_auth_key_here
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
SEARXNG_URL=http://localhost:8080/search
SEARCH_TIMEOUT=15
SEARCH_MAX_RETRIES=2
